{
	admin off
	auto_https off
}

:80 {
	handle /api/* {
		request_body {
			max_size 8KB
		}
		reverse_proxy grifos-api:8000
	}

	root * /srv
	encode zstd gzip
	@frescos path / /index.html /*.js /*.css /*.json /manifest.webmanifest /data/*
	header @frescos Cache-Control "no-cache"
	header X-Content-Type-Options nosniff
	file_server
}
